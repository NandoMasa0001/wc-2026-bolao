# --- Client (Vite) ---
# Fill these in from Supabase Console → Project Settings → API.
# When either is missing the app falls back to demo/mock mode and runs
# fully offline (no Supabase calls).
VITE_SUPABASE_URL=
# Either the new "publishable" key (sb_publishable_...) or the legacy
# JWT anon key (eyJhbGc...). Both work.
VITE_SUPABASE_ANON_KEY=

# --- Scripts (seed.mjs, fetch-results.mjs) ---
# Same URL as above (the script uses the canonical name without the VITE_ prefix).
SUPABASE_URL=
# The SECRET key (sb_secret_... or legacy service_role JWT). NEVER commit.
SUPABASE_SERVICE_KEY=

# football-data.org free-tier API key (https://www.football-data.org/client/register)
FOOTBALL_API_KEY=

# the-odds-api.com free-tier key (https://the-odds-api.com)
# Optional: if absent the cron skips odds-fetching and predictions score
# without the underdog boost.
ODDS_API_KEY=

# --- Tournament config (seed-time only) ---
SHARED_PASSWORD=
# ISO 8601; defaults to 2026-06-11T16:00:00Z
# TOURNAMENT_STARTS_AT=2026-06-11T16:00:00Z
# COMPETITION=WC
